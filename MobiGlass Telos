    // Corps asteroïde (irrégulier)
    ctx.save();
    ctx.fillStyle='#8a7a68';
    ctx.beginPath();
    ctx.ellipse(DX,DY,9,6,0.4,0,Math.PI*2);
    ctx.fill();
    ctx.strokeStyle='rgba(180,160,140,0.4)'; ctx.lineWidth=0.7;
    ctx.stroke();
    // Label
