});

/* ════════════════════════════════════════════════════════════
   ANIMATION LOOP
════════════════════════════════════════════════════════════ */
function loop(t) {
  mapAnim = t;
  // Hub mini map
  const hubCanvas = document.getElementById('stanton-canvas');
  if (hubCanvas && hubCanvas.width > 10) {
    if (!hubCanvas._inited) { initMap(hubCanvas); hubCanvas._inited = true; }
    drawMap(hubCanvas, hubCanvas.getContext('2d'), t);
  }
  // Full map panel
  const fullCanvas = document.getElementById('map-canvas-full');
  if (fullCanvas && fullCanvas.width > 10) {
    if (!fullCanvas._inited) { initMap(fullCanvas); fullCanvas._inited = true; }
    drawMap(fullCanvas, fullCanvas.getContext('2d'), t);
  }
  requestAnimationFrame(loop);
}

/* ════════════════════════════════════════════════════════════
   RESET COMPLET — vide tous les joueurs et stocks
════════════════════════════════════════════════════════════ */
async function resetAll() {
  // Supprimer les stocks de chaque joueur connu
  const existingPlayers = (await DB.get('uex-players')) || [];
  for (const p of existingPlayers) {
    await DB.del('uex-stocks-' + p.id);
  }
  // Vider la liste joueurs
  await DB.set('uex-players', []);
  // Vider aussi le localStorage au cas où
  try {
    Object.keys(localStorage)
      .filter(k => k.startsWith('uex-'))
      .forEach(k => localStorage.removeItem(k));
  } catch(e) {}
  players = [];
}


