function goPanel(id, el) {
  document.querySelectorAll('.nav-item').forEach(n=>n.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p=>p.classList.remove('active'));
  if (!el) {
    document.querySelectorAll('.nav-item').forEach(n=>{
      if ((n.getAttribute('onclick')||'').includes("'"+id+"'")) el=n;
    });
  }
  if (el) el.classList.add('active');
  const p = document.getElementById('panel-'+id);
  if (p) p.classList.add('active');
  if (id==='map')      { setTimeout(()=>{ const c=document.getElementById('map-canvas-full'); resizeCanvas(c); }, 60); }
  if (id==='joueurs')  { renderGlobal(); updateGlobalFilter(); }
  if (id==='stocks')   { renderStocksFromPlayers(); }
