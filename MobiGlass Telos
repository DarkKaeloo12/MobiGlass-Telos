    const margin  = s.price>0 && s.sellprice>0 ? ((s.sellprice-s.price)/s.price*100).toFixed(1) : null;
    const profit  = s.sellprice>0 ? sellVal - buyVal : null;
    const marginCls = margin>=0 ? 'td-green' : 'td-red';
